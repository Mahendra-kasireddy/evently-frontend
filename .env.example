# ============================================================================
# Evently Web — environment template
# Copy to `.env` and fill in real values. Only VITE_-prefixed vars are exposed
# to the client bundle. Values are validated at startup (see src/lib/env.ts);
# a missing/invalid URL fails the build/boot with a clear message.
# The active URL is chosen by Vite's --mode (development | qa | production).
# ============================================================================

# API base URL per environment (must be valid URLs)
VITE_API_BASE_URL_DEVELOPMENT=http://localhost:3000/api
VITE_API_BASE_URL_QA=https://qa-api.your-domain.com/api
VITE_API_BASE_URL_PRODUCTION=https://api.your-domain.com/api

# Display name
VITE_APP_NAME=Evently
